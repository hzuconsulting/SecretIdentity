{
  "name": "identite-secrete",
  "version": "0.1.0",
  "private": true,
  "description": "Identité Secrète — jeu de soirée multijoueur temps réel, mobile-first, 100 % statique et pair à pair",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @identite-secrete/web",
    "build": "npm run build -w @identite-secrete/web",
    "build:static": "npm run build:static -w @identite-secrete/web",
    "start": "npm run start -w @identite-secrete/web",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/engine && tsc --noEmit -p apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-partie.mjs",
    "test:e2e:manche": "node scripts/e2e-manche.mjs",
    "portraits": "vite-node scripts/portraits/build.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright-core": "^1.49.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  }
}
