# ─────────────────────────────────────────────────────────────
#  SERVEUR  (apps/server)  — à définir sur Railway / Fly / Render
# ─────────────────────────────────────────────────────────────

# Port d'écoute du serveur Socket.IO.
# En local : 4000. En production, l'hébergeur fournit souvent PORT automatiquement.
PORT=4000

# Origine(s) autorisée(s) pour CORS et Socket.IO.
# Plusieurs valeurs possibles, séparées par des virgules.
# En local : http://localhost:3000
# En production : https://identite-secrete.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# Environnement d'exécution : development | production
NODE_ENV=development


# ─────────────────────────────────────────────────────────────
#  CLIENT  (apps/web)  — à définir sur Vercel
# ─────────────────────────────────────────────────────────────

# URL publique du serveur Socket.IO, utilisée par le navigateur.
# En local : http://localhost:4000
# En production : https://identite-secrete-server.up.railway.app
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
